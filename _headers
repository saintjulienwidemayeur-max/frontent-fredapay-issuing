# En-têtes de sécurité et de cache. Ce fichier doit rester à la racine du dossier publié (Netlify ou Cloudflare Pages).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self)
  Strict-Transport-Security: max-age=31536000

# Espaces privés : jamais mis en cache ni indexés
/dashboard
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/checkout
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://api.tranzak.co")
/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/signup
  X-Robots-Tag: noindex
/sign
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/sign.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Anti-cache : le navigateur doit TOUJOURS revalider aupres du serveur avant de reutiliser un fichier
# (HTML, JS, images...). Si rien n'a change, le serveur repond 304 (rapide) ; sinon la derniere version est servie.
# Les regles s'additionnent : /dashboard et /checkout ci-dessus donnent "no-cache, no-store" (no-store l'emporte).
/*
  Cache-Control: no-cache, must-revalidate
  CDN-Cache-Control: no-cache
  Cloudflare-CDN-Cache-Control: no-cache

# Fichiers pour les assistants IA (GEO) : texte brut UTF-8, mis à jour souvent.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  ! Cache-Control
  ! CDN-Cache-Control
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=3600
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  ! Cache-Control
  ! CDN-Cache-Control
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=3600

# Images et polices qui ne changent pas : cache long (les HTML restent en no-cache et référencent ces fichiers).
# Les noms de fichiers sont stables : en cas de remplacement, changer le nom du fichier.
/images/*
  ! Cache-Control
  ! CDN-Cache-Control
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/team/*
  ! Cache-Control
  ! CDN-Cache-Control
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/logo-64.png
  ! Cache-Control
  ! CDN-Cache-Control
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/favicon-*
  ! Cache-Control
  ! CDN-Cache-Control
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  ! Cache-Control
  ! CDN-Cache-Control
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=2592000

# robots.txt: plain UTF-8 text.
/robots.txt
  Content-Type: text/plain; charset=utf-8
